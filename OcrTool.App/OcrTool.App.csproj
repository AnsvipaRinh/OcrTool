<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <TrimMode>none</TrimMode>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Version>1.0.2</Version>
    <Product>OCR Tool</Product>
    <Description>Windows tray OCR tool: hotkey region capture to clipboard, English + Russian.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OcrTool.Core\OcrTool.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="tray.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Update="tessdata_best\*.traineddata">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>